  {
    "id": "user-stop",
    "description": "Stop with active writer and unreachable owner.",
    "initial": {
      "files": {
        "wt-a/partial.txt": "partial"
      },
      "state": {
        "worker_b": "unreachable",
        "workers": {
          "worker-a": "working",
          "worker-b": "unreachable"
        }
      }
    },
    "injections": [
      {
        "actions": [
          {
            "op": "set",
            "key": "user_stop",
            "value": true
          }
        ],
        "shuffle": false
      }
    ],
    "invariants": [
      {
        "kind": "file",
        "name": "preserve wt-a/partial.txt",
        "path": "wt-a/partial.txt",
        "content": "partial"
      },
      {
        "kind": "event",
        "name": "observed interrupt",
        "match": {
          "kind": "interrupt",
          "target": "worker-a"
        }
      },
      {
        "kind": "state",
        "name": "worker_b",
        "key": "worker_b",
        "value": "stop-unconfirmed"
      },
      {
        "kind": "absent",
        "name": "no submit",
        "match": {
          "kind": "submit",
          "actor": "lead"
        }
      },
      {
        "kind": "absent",
        "name": "no mutate",
        "match": {
          "kind": "mutate",
          "actor": "lead"
        }
      },
      {
        "kind": "event",
        "name": "stop acknowledged",
        "match": {
          "kind": "interrupt_ack",
          "target": "worker-a"
        }
      },
      {
        "kind": "absent",
        "name": "no subsequent worker write",
        "match": {
          "kind": "worker_write",
          "target": "worker-a"
        }
      },
      {
        "kind": "absent",
        "name": "no lead write after stop",
        "match": {
          "kind": "write",
          "actor": "lead"
        }
      }
    ]
  },
  {
