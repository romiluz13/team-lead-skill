  {
    "id": "produced-but-rejected",
    "description": "A committed artifact fails a required check.",
    "initial": {
      "state": {
        "accepted": [],
        "revision": "r1"
      }
    },
    "injections": [
      {
        "actions": [
          {
            "op": "write",
            "path": "wt-a/code.py",
            "content": "broken"
          },
          {
            "op": "return",
            "attempt": "9",
            "path": "record/9.json",
            "result": {
              "attempt": "9",
              "passed": false,
              "revision": "r1"
            }
          }
        ],
        "shuffle": false
      }
    ],
    "invariants": [
      {
        "kind": "state",
        "name": "accepted",
        "key": "accepted",
        "value": []
      },
      {
        "kind": "state",
        "name": "status",
        "key": "status",
        "value": "produced-unaccepted"
      },
      {
        "kind": "event",
        "name": "observed read_result",
        "match": {
          "kind": "read_result",
          "path": "record/9.json"
        }
      },
      {
        "kind": "file",
        "name": "persist record/9.json",
        "path": "record/9.json",
        "content": "{\"attempt\": \"9\", \"passed\": false, \"revision\": \"r1\"}"
      },
      {
        "kind": "absent",
        "name": "no rejected acceptance",
        "match": {
          "kind": "accepted_result"
        }
      }
    ]
  },
  {
