[
  {
    "id": "submission-crash",
    "description": "Lead restart between submission and delivery reconciliation.",
    "initial": {
      "state": {
        "lead_session": "lead-a",
        "volatile": {
          "remembered_task": "7"
        }
      }
    },
    "injections": [
      {
        "actions": [
          {
            "op": "delivery",
            "attempt": "7",
            "session": "worker-a"
          },
          {
            "op": "restart",
            "session": "lead-b"
          }
        ],
        "shuffle": false
      }
    ],
    "invariants": [
      {
        "kind": "before",
        "name": "write before submit",
        "first": {
          "kind": "write",
          "path": "record/state.md"
        },
        "second": {
          "kind": "submit"
        }
      },
      {
        "kind": "count",
        "name": "one submission",
        "match": {
          "kind": "submit"
        },
        "value": 1
      },
      {
        "kind": "event",
        "name": "observed inspect",
        "match": {
          "kind": "inspect",
          "target": "worker-a"
        }
      },
      {
        "kind": "event",
        "name": "delivery observed",
        "match": {
          "kind": "delivery",
          "attempt": "7",
          "session": "worker-a"
        }
      },
      {
        "kind": "event",
        "name": "ack observed",
        "match": {
          "kind": "ack",
          "attempt": "7"
        }
      },
      {
        "kind": "file",
        "name": "persist record/state.md",
        "path": "record/state.md",
        "content": "7 worker-a possibly submitted"
      },
      {
        "kind": "event",
        "name": "disk reconciliation",
        "match": {
          "kind": "read_result",
          "path": "record/state.md"
        }
      }
    ]
  },
  {
    "id": "attempt-collision",
    "description": "Delayed original return competes with correction.",
    "initial": {
      "state": {
        "active": "7.2"
      }
    },
    "injections": [
      {
        "actions": [
          {
            "op": "return",
            "attempt": "7",
            "path": "record/7.json",
            "result": {
              "attempt": "7",
              "passed": true,
              "revision": "r1"
            }
          },
          {
            "op": "return",
            "attempt": "7.2",
            "path": "record/7.2.json",
            "result": {
              "attempt": "7.2",
              "passed": true,
              "revision": "r1"
            }
          }
        ],
        "shuffle": false
      }
    ],
    "invariants": [
      {
        "kind": "state",
        "name": "accepted",
        "key": "accepted",
        "value": [
          {
            "attempt": "7.2",
            "passed": true,
            "revision": "r1"
          }
        ]
      },
      {
        "kind": "event",
        "name": "observed read_result",
        "match": {
          "kind": "read_result",
          "path": "record/7.2.json"
        }
      },
      {
        "kind": "file",
        "name": "persist record/7.2.json",
        "path": "record/7.2.json",
        "content": "{\"attempt\": \"7.2\", \"passed\": true, \"revision\": \"r1\"}"
      },
      {
        "kind": "event",
        "name": "acceptance observed 7.2",
        "match": {
          "kind": "accepted_result",
          "result": {
            "attempt": "7.2",
            "passed": true,
            "revision": "r1"
          }
        }
      }
    ]
  },
  {
    "id": "concurrent-reports",
