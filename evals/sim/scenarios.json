            "result": {
              "attempt": "1",
              "passed": true,
              "revision": "r1"
            }
          },
          {
            "op": "return",
            "attempt": "2",
            "path": "record/2.json",
            "result": {
              "attempt": "2",
              "passed": true,
              "revision": "r1"
            }
          }
        ],
        "shuffle": true
      }
    ],
    "invariants": [
      {
        "kind": "state",
        "name": "accepted",
        "key": "accepted",
        "value": [
          {
            "attempt": "1",
            "passed": true,
            "revision": "r1"
          },
          {
            "attempt": "2",
            "passed": true,
            "revision": "r1"
          }
        ]
      },
      {
        "kind": "absent",
        "name": "no notify",
        "match": {
          "kind": "notify"
        }
      },
      {
        "kind": "event",
        "name": "observed return_persisted",
        "match": {
          "kind": "return_persisted",
          "attempt": "1"
        }
      },
      {
        "kind": "event",
        "name": "observed return_persisted",
        "match": {
          "kind": "return_persisted",
          "attempt": "2"
        }
      },
      {
        "kind": "file",
        "name": "persist record/1.json",
        "path": "record/1.json",
        "content": "{\"attempt\": \"1\", \"passed\": true, \"revision\": \"r1\"}"
      },
      {
        "kind": "file",
        "name": "persist record/2.json",
        "path": "record/2.json",
        "content": "{\"attempt\": \"2\", \"passed\": true, \"revision\": \"r1\"}"
      },
      {
        "kind": "event",
        "name": "acceptance observed 1",
        "match": {
          "kind": "accepted_result",
          "result": {
            "attempt": "1",
            "passed": true,
            "revision": "r1"
          }
        }
      },
      {
        "kind": "event",
        "name": "acceptance observed 2",
        "match": {
          "kind": "accepted_result",
          "result": {
            "attempt": "2",
            "passed": true,
            "revision": "r1"
          }
        }
      }
    ]
  },
